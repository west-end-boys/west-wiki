#!/usr/bin/env bash
set -euo pipefail

# Markdown-only bypass: if every staged file is a .md/.markdown file, skip
# checks entirely and let the commit through. Docs-only commits shouldn't be
# blocked by code checks.
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged_files" ] && ! echo "$staged_files" | grep -qvE '\.(md|markdown)$'; then
    exit 0
fi

npm run lint
npm run typecheck
npm test
